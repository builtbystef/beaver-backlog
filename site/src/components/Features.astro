---
const features = [
	{
		title: 'Markdown-first',
		body: 'Every issue is a human-readable .md file with a small YAML header. Read it, edit it, diff it, and review it like any other file.',
	},
	{
		title: 'Local by default',
		body: 'Issues live on your disk, in your project. No external service, account, or database to set up or keep alive.',
	},
	{
		title: 'Version-control-friendly',
		body: 'Plain text that Git diffs and merges cleanly. Issues branch, get reviewed, and ship with the code they describe.',
	},
	{
		title: 'Agent-friendly',
		body: 'Coding agents read, create, and update issues through the same files and commands as you, and every write names who made it.',
	},
	{
		title: 'Nothing hidden',
		body: 'The files are the only source of truth. The CLI and the web UI are thin clients over them; hand-editing an issue file is a first-class operation.',
	},
	{
		title: 'One binary',
		body: 'A single Go binary with no daemon and no build step. Install in one line on macOS, Linux, and Windows.',
	},
];
---

<section class="landing-section not-content">
	<div class="landing-head">
		<h2 class="landing-heading">Most trackers live outside the codebase. This one travels with it.</h2>
	</div>
	<ol class="features">
		{
			features.map((feature) => (
				<li>
					<h3>{feature.title}</h3>
					<p>{feature.body}</p>
				</li>
			))
		}
	</ol>
</section>

<style>
	/* Six cards, each a paper note with an ink edge and a hard shadow, in the
	   hero's vocabulary. */
	.features {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
		gap: 1.5rem;
	}

	.features li {
		background: var(--surface);
		border: 2px solid var(--ink);
		border-radius: 0.875rem;
		box-shadow: 4px 4px 0 var(--ink);
		padding: 1.5rem 1.5rem 1.625rem;
		min-width: 0;
		display: flex;
		flex-direction: column;
	}


	.features h3 {
		margin: 0 0 0.5rem;
		font-size: 1.0625rem;
		font-weight: 700;
		letter-spacing: -0.015em;
		line-height: 1.3;
		color: var(--ink);
	}

	.features p {
		margin: 0;
		color: var(--ink-muted);
		font-size: 0.9375rem;
		line-height: 1.6;
	}
</style>
