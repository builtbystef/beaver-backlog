  "script": "const svg=document.querySelector('svg.graph');const w=+svg.getAttribute('width'),h=+svg.getAttribute('height');const r=svg.getBoundingClientRect();const vh=h*0.5;const vw=vh*r.width/r.height;svg.setAttribute('viewBox',`${w/2-vw/2} ${-h*0.01} ${vw} ${vh}`);"
