 {
  "name": "new-issue",
  "url": "http://127.0.0.1:2340/issues/new",
  "theme": "light",
  "script": "const f=document.querySelector('[name=title]').form;const set=(k,v)=>{const e=f.querySelector(`[name=${k}]`);if(e)e.value=v;};set('title','Show a reading progress bar in reader mode');set('description','A thin bar at the top of the reader that fills as the reader scrolls.\\n\\n- Hidden until the first scroll\\n- Follows the typography settings for colour');set('priority','medium');set('labels','ux, feature');set('parent','z969o1');"
