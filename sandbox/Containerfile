# Agent sandbox image for beaver-backlog. Built and run only via sandbox/start.sh;
# everything installed here is reachable solely from inside the sandbox.
FROM ubuntu:24.04

RUN apt-get update && \
    apt-get install -y \
        git \
        curl \
        ca-certificates \
        build-essential \
        ripgrep \
        jq \
    && rm -rf /var/lib/apt/lists/*

# Go toolchain matching go.mod (go 1.26); apt's golang is too old.
RUN curl -fsSL https://go.dev/dl/go1.26.0.linux-amd64.tar.gz | tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:/root/go/bin:${PATH}"

# golangci-lint — the repo's lint check.
RUN curl -sSfL https://raw.githubusercontent.com/golangci/golangci-lint/HEAD/install.sh \
    | sh -s -- -b /usr/local/bin

# Node.js for the agent CLIs.
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code @openai/codex

WORKDIR /workspace
