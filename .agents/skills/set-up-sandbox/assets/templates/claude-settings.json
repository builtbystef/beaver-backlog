{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "filesystem": {
      "allowRead": [
        "**/site-packages/certifi/cacert.pem",
        "**/site-packages/botocore/cacert.pem"
      ],
      "denyRead": [
        "~/Main",
        "~/dotfiles",
        "~/.ssh",
        "~/.gnupg",
        "~/.aws",
        "~/.kube",
        "~/.docker",
        "~/.config/gh",
        "~/.config/gcloud",
        "~/.local/share/keyrings",
        "~/.claude/.credentials.json",
        "~/.claude.json",
        "~/.claude.json.backup",
        "~/.codex/auth.json",
        "~/.pi/agent/auth.json",
        "~/.netrc",
        "~/.npmrc",
        "~/.pgpass",
        "/run/docker.sock",
        "/run/user/1000/podman/podman.sock",
        "/run/user/1000/keyring",
        "/run/user/1000/gnupg"
      ],
      "allowWrite": [
        "/tmp",
        "~/.cache",
        "~/.npm",
        "~/.local/share/pnpm",
        "~/.cargo/registry",
        "~/.cargo/git",
        "~/go/pkg/mod"
      ],
      "denyWrite": [
        "~/.cache/ccache",
        "~/.cache/go-build"
      ]
    }
  },
  "permissions": {
    "allow": [
      "WebFetch(domain:*)"
    ],
    "deny": [
      "Read(~/Main/**)",
      "Edit(~/Main/**)",
      "Read(~/dotfiles/**)",
      "Edit(~/dotfiles/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/**)",
      "Read(~/.kube/**)",
      "Read(~/.docker/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.local/share/keyrings/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.claude.json.backup)",
      "Read(~/.codex/auth.json)",
      "Read(~/.pi/agent/auth.json)",
      "Read(~/.netrc)",
      "Read(~/.npmrc)",
      "Read(~/.pgpass)",
      "Read(~/Code/**/.env*)",
      "Read(~/Code/**/*.pem)",
      "Read(~/Code/**/*.key)",
      "Edit(~/.ssh/**)",
      "Edit(~/.gnupg/**)",
      "Edit(~/.aws/**)",
      "Edit(~/.kube/**)",
      "Edit(~/.docker/**)",
      "Edit(~/.config/gh/**)",
      "Edit(~/.config/gcloud/**)",
      "Edit(~/.local/share/keyrings/**)",
      "Edit(~/.claude/**)",
      "Edit(~/.claude.json)",
      "Edit(~/.pi/**)",
      "Edit(~/.netrc)",
      "Edit(~/.npmrc)",
      "Edit(~/.bashrc)",
      "Edit(~/.bash_profile)",
      "Edit(~/.zshrc)",
      "Edit(~/.zshenv)",
      "Edit(~/.zprofile)",
      "Edit(~/.profile)",
      "Edit(~/.gitconfig)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.claude/**)",
      "Edit(.pi/**)",
      "Edit(.mcp.json)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(doas:*)",
      "Bash(pkexec:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)",
      "Bash(docker:*)",
      "Bash(podman:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)"
    ]
  }
}
